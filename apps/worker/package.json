{
  "name": "cf-gitea-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:remote": "wrangler d1 migrations apply cf-gitea --remote",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cf-gitea --local"
  },
  "dependencies": {
    "@cf-gitea/git-engine": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "markdown-it": "^14.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
