{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-gitea",
  "main": "src/index.ts",
  // Newest date the current local runtime supports (AGENTS.md wants today's
  // date; no published workerd supports 2026-10-24 yet). Bump to the current
  // date together with `pnpm update wrangler` + `pnpm install`, then run
  // `wrangler types`.
  "compatibility_date": "2026-10-19",
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // Single source of truth for bindings (AGENTS.md). After any change here,
  // run `wrangler types` to regenerate worker-configuration.d.ts.

  // D1: relational metadata (ADR-0001 D3). The database_id is a placeholder
  // until `wrangler d1 create cf-gitea` provisions the real database for
  // deployment; local dev and tests do not use it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-gitea",
      "database_id": "a72f93d3-f85a-411e-880e-7effaed306bb",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // R2: blob storage (packs, later LFS/attachments) — SPEC-0001 §3.
  "r2_buckets": [
    {
      "binding": "REPO_PACKS",
      "bucket_name": "cf-gitea-packs"
    }
  ],

  // Static assets (SPEC-0008 §2.3.2, exact): the built Gitea frontend tree
  // (`pnpm build:assets` → ./public/assets, gitignored) plus the committed
  // public/_headers. Assets-first/worker-on-miss routing: GET/HEAD matching a
  // file in public/ is edge-served; a miss invokes the Worker. The four
  // git-protocol routes, /api/* and the LFS family are pinned to the Worker
  // first so they can never be shadowed by the asset tree (see the spec for
  // the enumeration rationale; two leading wildcards span /:owner/:repo(.git)?).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/*/*/info/refs",
      "/*/*/git-upload-pack",
      "/*/*/git-receive-pack",
      "/*/*/HEAD",
      "/*/*/info/lfs/*"
    ]
  },

  // Durable Objects: the vendored engine's classes (packages/git-engine).
  // RepoCell = per-repo git storage (SPEC-0001 §2); Registry = repo index.
  // SQLite-backed classes only.
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoCell"
      },
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      }
    ]
  },

  // Cron triggers (SPEC-0009 §2.6): the pull-mirror sync producer fires the
  // 10-minute `update_mirrors` cadence (upstream tasks_basic.go:35). Sub-hour
  // crons get a 30 s CPU budget (AGENTS.md Workers rules), so the scheduled
  // handler only SELECTs due repo_mirrors rows and enqueues — the mirror-sync
  // work happens in the queue consumer.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // Queues: REPO_TASKS drives the repo delete purge (SPEC-0003 §2.5.5 steps
  // 2-3: D1 tx → DO tombstone → queue → R2 prefix purge). Batch 1 + a single
  // in-flight delivery keep each purge inside its own subrequest budget; the
  // consumer's steps are idempotent, so redelivery is safe. The import
  // indexing consumer (§2.6) and the pull-mirror sync consumer (SPEC-0009
  // §2.6, {kind: "mirror-sync"} messages from MIRROR_SYNC_QUEUE) join the
  // same queue + serialized consumer via the handleRepoTasks dispatch.
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_DELIVERY", "queue": "webhook-delivery" },
      { "binding": "REPO_TASKS", "queue": "repo-tasks" },
      { "binding": "MIRROR_SYNC_QUEUE", "queue": "repo-tasks" }
    ],
    "consumers": [
      { "queue": "webhook-delivery", "max_retries": 3, "dead_letter_queue": "webhook-delivery-dlq" },
      { "queue": "webhook-delivery-dlq", "max_retries": 1, "max_batch_size": 10 },
      {
        "queue": "repo-tasks",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5
        // No dead_letter_queue yet: after max_retries the message is dropped
        // with an observability-log trace per attempt (the admin-notice
        // equivalent). A DLQ joins when the import consumer (M5) lands.
      }
    ]
  },

  // Secrets (names only — values are NEVER in this file; AGENTS.md Workers
  // rules). `wrangler types` includes these in Env even without .dev.vars, so
  // CI typechecks stay honest; local dev supplies values via .dev.vars (copy
  // .dev.vars.example). Production: `wrangler secret put GIT_TOKEN`.
  // GIT_TOKEN gates git push/admin on the engine (SPEC-0001 M1); SPEC-0002
  // replaces the static token with real auth. The two MIRROR_* keys are
  // SPEC-0009 §4.1/§4.2 runtime config (SSRF allow-list + credential AES
  // key) — until they are declared here, wrangler silently ignores them in
  // .dev.vars (only declared names load; probed on wrangler 4.152).
  "secrets": {
    "required": ["GIT_TOKEN", "MIRROR_ALLOWED_HOST_LIST", "MIRROR_CREDENTIAL_KEY"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoCell", "Registry"]
    }
  ]
}
