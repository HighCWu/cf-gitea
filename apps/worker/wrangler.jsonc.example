{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-gitea",
  "main": "src/index.ts",
  // Newest date the pinned local runtime supports (AGENTS.md wants today's
  // date; re-verified 2026-10-25 — wrangler 4.152.0 still pairs miniflare
  // 5.20261019.2-beta, the newest 5.x build, so no newer date is runnable).
  // Bump to the current date together with `pnpm update wrangler` +
  // `pnpm install`, then run `wrangler types`.
  "compatibility_date": "2026-10-19",
  "limits": {
    "cpu_ms": 300000
  },
  // Module rules: the fileicon layer (src/ui/fileicon/, cdf683a) imports its
  // basic-theme SVGs and both material-icon JSON pools as `*.svg?raw` /
  // *.json?raw strings — vite serves ?raw natively (so dev/tests never
  // trip), but `wrangler deploy`'s esbuild IGNORES the query and applies its
  // built-in loaders (the .json loader returns a PARSED OBJECT —
  // JSON.parse(object) threw on every tree-view envelope request in
  // production, 2026-10-26); rule globs must carry the query suffix
  // themselves (REDEPLOY18's controlled tests: plain **/*.svg does NOT match
  // **/*.svg?raw). LESSON: any NEW `?raw` import in the deploy entry graph
  // needs a glob member here — the vite affordance is invisible to wrangler
  // until an edge first carries it (svg at 831709f, json at this rule).
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.svg?raw", "**/*.json?raw"]
    }
  ],
  // Webhook payload compare URLs (mirror sync + user push) — upstream's own
  // AppURL equivalent. OPTIONAL: unset it and payload URLs automatically use
  // this deployment's own origin (a fresh Deploy-button deployment on
  // *.workers.dev needs zero configuration). Set it when serving behind a
  // custom domain, or for mirror deployments whose payload URLs must name a
  // different public origin. Local dev overrides via .dev.vars if needed.
  // (The line stays as documentation of the shape — the generated Env types
  // the declared var, and the fallback chain in
  // services/webhooks-push.ts `appOrigin` serves unset deployments.)
  "vars": {
    "APP_URL": "https://cf-gitea.YOUR-SUBDOMAIN.workers.dev",
    // Self-registration gate (SPEC-0010 §6): "true" adds a /user/sign_up page;
    // anything else keeps the instance closed — the first admin comes from the
    // login page's one-shot "initialize this instance" form (zero-user instances).
    "ALLOW_SIGNUP": "false"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // Single source of truth for bindings (AGENTS.md). This EXAMPLE file is the
  // template: `pnpm setup:deploy` copies it to wrangler.jsonc (gitignored)
  // and fills the real database_id; the Deploy-to-Cloudflare button
  // provisions resources and fills ids automatically. After any change here,
  // run `wrangler types` to regenerate worker-configuration.d.ts.

  // D1: relational metadata (ADR-0001 D3). The database_id placeholder is
  // filled by `pnpm setup:deploy` (or the deploy button); local dev and
  // tests do not use it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-gitea",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // R2: blob storage (packs, later LFS/attachments) — SPEC-0001 §3.
  "r2_buckets": [
    {
      "binding": "REPO_PACKS",
      "bucket_name": "cf-gitea-packs"
    }
  ],

  // Static assets (SPEC-0008 §2.3.2, exact): the built Gitea frontend tree
  // (`pnpm build:assets` → ./public/assets, gitignored) plus the committed
  // public/_headers. Assets-first/worker-on-miss routing: GET/HEAD matching a
  // file in public/ is edge-served; a miss invokes the Worker. The four
  // git-protocol routes, /api/* and the LFS family are pinned to the Worker
  // first so they can never be shadowed by the asset tree (see the spec for
  // the enumeration rationale; two leading wildcards span /:owner/:repo(.git)?).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/*/*/info/refs",
      "/*/*/git-upload-pack",
      "/*/*/git-receive-pack",
      "/*/*/HEAD",
      "/*/*/info/lfs/*"
    ]
  },

  // Durable Objects: the vendored engine's classes (packages/git-engine).
  // RepoCell = per-repo git storage (SPEC-0001 §2); Registry = repo index.
  // SQLite-backed classes only.
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoCell"
      },
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      }
    ]
  },

  // Cron triggers (SPEC-0009 §2.6): the pull-mirror sync producer fires the
  // 10-minute `update_mirrors` cadence (upstream tasks_basic.go:35). Sub-hour
  // crons get a 30 s CPU budget (AGENTS.md Workers rules), so the scheduled
  // handler only SELECTs due repo_mirrors rows and enqueues — the mirror-sync
  // work happens in the queue consumer.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  // Queues: REPO_TASKS drives the repo delete purge (SPEC-0003 §2.5.5 steps
  // 2-3: D1 tx → DO tombstone → queue → R2 prefix purge). Batch 1 + a single
  // in-flight delivery keep each purge inside its own subrequest budget; the
  // consumer's steps are idempotent, so redelivery is safe. The import
  // indexing consumer (§2.6) and the pull-mirror sync consumer (SPEC-0009
  // §2.6, {kind: "mirror-sync"} messages from MIRROR_SYNC_QUEUE) join the
  // same queue + serialized consumer via the handleRepoTasks dispatch.
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_DELIVERY", "queue": "webhook-delivery" },
      { "binding": "REPO_TASKS", "queue": "repo-tasks" },
      { "binding": "MIRROR_SYNC_QUEUE", "queue": "repo-tasks" }
    ],
    "consumers": [
      { "queue": "webhook-delivery", "max_retries": 3, "dead_letter_queue": "webhook-delivery-dlq" },
      { "queue": "webhook-delivery-dlq", "max_retries": 1, "max_batch_size": 10 },
      { "queue": "repo-tasks-dlq", "max_retries": 1, "max_batch_size": 10 },
      {
        "queue": "repo-tasks",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "repo-tasks-dlq"
      }
    ]
  },

  // Secrets (names only — values are NEVER in this file; AGENTS.md Workers
  // rules). `wrangler types` includes these in Env even without .dev.vars, so
  // CI typechecks stay honest; local dev supplies values via .dev.vars (copy
  // .dev.vars.example). Production: `wrangler secret put GIT_TOKEN`.
  // GIT_TOKEN gates git push/admin on the engine (SPEC-0001 M1); SPEC-0002
  // replaces the static token with real auth. The two MIRROR_* keys are
  // SPEC-0009 §4.1/§4.2 runtime config (SSRF allow-list + credential AES
  // key) — until they are declared here, wrangler silently ignores them in
  // .dev.vars (only declared names load; probed on wrangler 4.152).
  "secrets": {
    "required": ["GIT_TOKEN", "MIRROR_ALLOWED_HOST_LIST", "MIRROR_CREDENTIAL_KEY"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoCell", "Registry"]
    }
  ]
}
