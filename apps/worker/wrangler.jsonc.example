{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-gitea",
  "main": "src/index.ts",
  // Newest date the pinned local runtime supports (AGENTS.md wants today's
  // date; re-verified 2026-10-29 — wrangler 4.153.0 pairs miniflare
  // 5.20261023.0-beta / workerd 1.20261023.1, which runs compatibility
  // dates only through 2026-10-23, so no newer date is runnable yet).
  // Bump to the current date together with `pnpm update wrangler` +
  // `pnpm install`, then run `wrangler types`.
  "compatibility_date": "2026-10-23",
  "limits": {
    "cpu_ms": 300000
  },
  // Module rules: the fileicon layer (src/ui/fileicon/, cdf683a) imports its
  // basic-theme SVGs and both material-icon JSON pools as `*.svg?raw` /
  // *.json?raw strings — vite serves ?raw natively (so dev/tests never
  // trip), but `wrangler deploy`'s esbuild IGNORES the query and applies its
  // built-in loaders (the .json loader returns a PARSED OBJECT —
  // JSON.parse(object) threw on every tree-view envelope request in
  // production, 2026-10-26); rule globs must carry the query suffix
  // themselves (REDEPLOY18's controlled tests: plain **/*.svg does NOT match
  // **/*.svg?raw). LESSON: any NEW `?raw` import in the deploy entry graph
  // needs a glob member here — the vite affordance is invisible to wrangler
  // until an edge first carries it (svg at 831709f, json at this rule).
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.svg?raw", "**/*.json?raw"]
    }
  ],
  // Webhook payload compare URLs (mirror sync + user push) — upstream's own
  // AppURL equivalent. OPTIONAL: unset it and payload URLs automatically use
  // this deployment's own origin (a fresh Deploy-button deployment on
  // *.workers.dev needs zero configuration). Set it when serving behind a
  // custom domain, or for mirror deployments whose payload URLs must name a
  // different public origin. Local dev overrides via .dev.vars if needed.
  // (The line stays as documentation of the shape — the generated Env types
  // the declared var, and the fallback chain in
  // services/webhooks-push.ts `appOrigin` serves unset deployments.)
  "vars": {
    "APP_URL": "https://cf-gitea.YOUR-SUBDOMAIN.workers.dev",
    // Self-registration gate (SPEC-0010 §6): "true" adds a /user/sign_up page;
    // anything else keeps the instance closed — the first admin comes from the
    // login page's one-shot "initialize this instance" form (zero-user instances).
    "ALLOW_SIGNUP": "false",
    // Federation gate (specs/federation.md Tier A): ONLY the exact string
    // "true" mounts the discovery pair (GET /.well-known/nodeinfo,
    // GET /.well-known/webfinger) and the registered-but-501 stubs
    // (GET /api/v1/nodeinfo, ANY /api/v1/activitypub/*); absent/anything
    // else answers upstream's disabled posture — web pair 404 "Not Found",
    // API arms 404 from the router (fail-closed, upstream's own default:
    // setting.Federation.Enabled=false, modules/setting/federation.go:23;
    // the gate wraps the web pair at web.go:409-414 and the API
    // registration at api.go:1007-1010). Upstream retracted the ActivityPub
    // data plane at this pin (PR #36789 — "wait until the whole design is
    // stable and usable"), so even enabled, the webfinger JRD advertises
    // actor IRIs that answer 501 "Not implemented" — discovery-only, by
    // upstream's own posture.
    "FEDERATION_ENABLED": "false",
    // SPEC-0014 §2 — the demo-operations gate. ONLY the exact string "true"
    // arms the demo sweep (hourly cron producer → {kind:"demo-sweep"} → the
    // existing delete cascade); absent/anything else stays OFF (fail-closed,
    // §6.8). Default OFF so a self-hosted deployment NEVER schedules cleanup
    // and NEVER deletes user data — the README's self-host guarantee (the §2
    // hard invariant). The demo instance is the ONLY deployment that sets it
    // to "true"; arming is a var edit + redeploy, never a runtime toggle.
    "DEMO_MODE": "false",
    // Audit-event retention window in days (SPEC-0015 M4 §4.3). Any value
    // other than a positive integer DISARMS the retention producer entirely
    // (fail-closed: no reads, no sends); the consumer defaults to 90.
    "AUDIT_RETENTION_DAYS": "90",
    // Actions retention windows in days (SPEC-0012 §4.4/§4.5) — the strict-
    // polarity trio. Upstream defaults 90/365/400 (modules/setting/actions.go:
    // 15-21); each value must be a positive integer or that arm stays OFF
    // (fail-closed: unset/garbage/zero/negative = no reads, no sends — unlike
    // upstream, whose cleanup cron is always-on with the defaults, a default
    // cf-gitea deployment NEVER deletes actions data). Arming any one var
    // enables the hourly probe + sweep for the armed arms only; the artifact
    // var additionally documents the upload-time expiry ceiling (that wiring
    // is a tracked follow-up). Set all three to 90/365/400 for upstream
    // behavior.
    "ACTIONS_ARTIFACT_RETENTION_DAYS": "90",
    "ACTIONS_LOG_RETENTION_DAYS": "365",
    "ACTIONS_RUN_RETENTION_DAYS": "400",
    // Packages registry (SPEC-0016): all strict-polarity — omitted falls back
    // to the code defaults (512 MiB generic cap, unlimited counts, enabled,
    // 24h cleanup window).
    "PACKAGES_LIMIT_SIZE_GENERIC": "536870912",
    "PACKAGES_LIMIT_TOTAL_OWNER_COUNT": "-1",
    "PACKAGES_LIMIT_TOTAL_OWNER_SIZE": "-1",
    "PACKAGES_ENABLED": "true",
    "PACKAGE_CLEANUP_OLDER_THAN": "24",
    // OAuth2 provider (specs/oauth2-provider.md §2.11, W4): strict polarity —
    // ONLY the exact string "false" disables; default "true" is upstream's
    // (setting.OAuth2.Enabled, modules/setting/oauth2.go:104). False ⇒ 403
    // on the whole /login/oauth group (web.go:373-378/631's oauth2Enabled),
    // 404 on /.well-known/openid-configuration (oauth2_wellknown.go:17-20),
    // and the git-HTTP 401 realm reverting to `Basic realm="Gitea (Basic
    // Auth)"` (githttp.go:146-159 — enabled answers `realm="Gitea"` so GCM
    // drives its built-in OAuth2 application, git-credential-manager#1442).
    "OAUTH2_ENABLED": "true",
    // The id_token/JWKS signing algorithm (specs/oauth2-provider.md §2.10):
    // one of HS256/384/512, RS256/384/512, ES256/384/512 (upstream's set,
    // modules/setting/oauth2.go:108; EdDSA is rejected-until-proven on
    // workerd — SPEC divergence (c)). The key lives in the `system_keystore`
    // `oauth2_signing_key` row (get-or-create on first use); HS* reuses the
    // shared general-token-signing-secret row (upstream's JWT_SECRET role).
    // RS256 stays the default and the recommended arm.
    "OAUTH2_SIGNING_ALGORITHM": "RS256",
    // The OIDC `iss` claim + discovery `issuer` override ([oauth2]
    // JWT_CLAIM_ISSUER, access_token.go:142-145). Empty/unset derives the
    // issuer from APP_URL minus the trailing slash — the
    // openid-connect-discovery §4 rule (the issuer MUST equal the URL
    // /.well-known/openid-configuration was fetched from). Only moves the
    // `issuer` member; the endpoint URLs always follow APP_URL.
    "OAUTH2_JWT_CLAIM_ISSUER": "",
    // Outbound email (specs/email-outbound.md §6): strict-polarity, OFF by
    // default — a self-hosted deployment NEVER sends mail until armed, the
    // same fail-closed class as DEMO_MODE. Arming = MAIL_ENABLED "true" +
    // MAIL_FROM + a provider: "dummy" (the default — upstream's dummy
    // protocol, services/mailer/sender/dummy.go: render+log+succeed) or
    // "resend" (the HTTP relay arm — also
    // `wrangler secret put MAIL_PROVIDER_API_KEY`). The first wired trigger
    // is POST /admin/users with send_notify=true (upstream
    // routers/api/v1/admin/user.go:153-156); MAIL_SUBJECT_PREFIX /
    // MAIL_API_BASE are optional.
    "MAIL_ENABLED": "false",
    "MAIL_PROVIDER": "dummy",
    "MAIL_FROM": "",
    "MAIL_SUBJECT_PREFIX": "",
    "MAIL_API_BASE": "",
    // Inbound email (specs/email-inbound.md §8): strict-polarity, OFF by
    // default — Cloudflare Email Routing delivers to the Worker's `email()`
    // handler (NO binding; the handler export is the whole story). Arming =
    // MAIL_INBOUND_ENABLED "true" + MAIL_INBOUND_REPLY_ADDRESS carrying
    // %{token} exactly once in the user part (upstream REPLY_TO_ADDRESS,
    // modules/setting/incoming_email.go:15,47-63) + `wrangler secret put
    // MAIL_INBOUND_SECRET` + an Email Routing rule on the zone delivering
    // to this Worker. Until the outbound notify fold (email-inbound §9
    // HANDOFF) no mail carries a token, so an armed inbound drops
    // everything at the no-token gate — fail-closed end to end.
    "MAIL_INBOUND_ENABLED": "false",
    "MAIL_INBOUND_REPLY_ADDRESS": ""
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // Single source of truth for bindings (AGENTS.md). This EXAMPLE file is the
  // template: `pnpm setup:deploy` copies it to wrangler.jsonc (gitignored)
  // and fills the real database_id; the Deploy-to-Cloudflare button
  // provisions resources and fills ids automatically. After any change here,
  // run `wrangler types` to regenerate worker-configuration.d.ts.

  // D1: relational metadata (ADR-0001 D3). The database_id placeholder is
  // filled by `pnpm setup:deploy` (or the deploy button); local dev and
  // tests do not use it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-gitea",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // R2: blob storage (packs, later LFS/attachments) — SPEC-0001 §3.
  "r2_buckets": [
    {
      "binding": "REPO_PACKS",
      "bucket_name": "cf-gitea-packs"
    }
  ],

  // Static assets (SPEC-0008 §2.3.2, exact): the built Gitea frontend tree
  // (`pnpm build:assets` → ./public/assets, gitignored) plus the committed
  // public/_headers. Assets-first/worker-on-miss routing: GET/HEAD matching a
  // file in public/ is edge-served; a miss invokes the Worker. The four
  // git-protocol routes, /api/* and the LFS family are pinned to the Worker
  // first so they can never be shadowed by the asset tree (see the spec for
  // the enumeration rationale; two leading wildcards span /:owner/:repo(.git)?).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/v2/*",
      "/*/*/info/refs",
      "/*/*/git-upload-pack",
      "/*/*/git-receive-pack",
      "/*/*/HEAD",
      "/*/*/info/lfs/*"
    ]
  },

  // Durable Objects: the vendored engine's classes (packages/git-engine).
  // RepoCell = per-repo git storage (SPEC-0001 §2); Registry = repo index.
  // SQLite-backed classes only.
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoCell"
      },
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      }
    ]
  },

  // Cron triggers (SPEC-0009 §2.6): the pull-mirror sync producer fires the
  // 10-minute `update_mirrors` cadence (upstream tasks_basic.go:35). Sub-hour
  // crons get a 30 s CPU budget (AGENTS.md Workers rules), so the scheduled
  // handler only SELECTs due repo_mirrors rows and enqueues — the mirror-sync
  // work happens in the queue consumer.
  //
  // The hourly entry (SPEC-0014 §3.1) is the demo sweep's producer tick. The
  // scheduled dispatcher (services/demo-sweep.ts handleScheduledCron) routes
  // it ONLY to enqueueDueDemoSweeps, which checks DEMO_MODE before its first
  // D1 read — with the gate off (the default above) the invocation is a
  // silent no-op: zero D1 reads, zero queue sends. At :00 both entries fire
  // as separate invocations; the mirror producers keep their unconditional
  // posture on the */10 entries (their CAS guard absorbs any overlap).
  // OQ-2 (ratified): the entry ships in THIS example config even though a
  // gate-off deployment pays one no-op hourly invocation — config
  // monogeneity (this file is the single source of truth) beats a
  // hand-maintained demo delta whose worst failure is a silently-armed-but-
  // never-firing sweep.
  "triggers": {
    "crons": ["*/10 * * * *", "0 * * * *"]
  },

  // Queues: REPO_TASKS drives the repo delete purge (SPEC-0003 §2.5.5 steps
  // 2-3: D1 tx → DO tombstone → queue → R2 prefix purge). Batch 1 + a single
  // in-flight delivery keep each purge inside its own subrequest budget; the
  // consumer's steps are idempotent, so redelivery is safe. The import
  // indexing consumer (§2.6) and the pull-mirror sync consumer (SPEC-0009
  // §2.6, {kind: "mirror-sync"} messages from MIRROR_SYNC_QUEUE) join the
  // same queue + serialized consumer via the handleRepoTasks dispatch.
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_DELIVERY", "queue": "webhook-delivery" },
      { "binding": "REPO_TASKS", "queue": "repo-tasks" },
      { "binding": "MIRROR_SYNC_QUEUE", "queue": "repo-tasks" }
    ],
    "consumers": [
      { "queue": "webhook-delivery", "max_retries": 3, "dead_letter_queue": "webhook-delivery-dlq" },
      { "queue": "webhook-delivery-dlq", "max_retries": 1, "max_batch_size": 10 },
      { "queue": "repo-tasks-dlq", "max_retries": 1, "max_batch_size": 10 },
      {
        "queue": "repo-tasks",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "repo-tasks-dlq"
      }
    ]
  },

  // Secrets (names only — values are NEVER in this file; AGENTS.md Workers
  // rules). `wrangler types` includes these in Env even without .dev.vars, so
  // CI typechecks stay honest; local dev supplies values via .dev.vars (copy
  // .dev.vars.example). Production: `wrangler secret put GIT_TOKEN`.
  // GIT_TOKEN gates git push/admin on the engine (SPEC-0001 M1); SPEC-0002
  // replaces the static token with real auth. The two MIRROR_* keys are
  // SPEC-0009 §4.1/§4.2 runtime config (SSRF allow-list + credential AES
  // key) — until they are declared here, wrangler silently ignores them in
  // .dev.vars (only declared names load; probed on wrangler 4.152).
  // MAIL_PROVIDER_API_KEY is specs/email-outbound.md §6: consumed ONLY when
  // MAIL_PROVIDER=resend; mail stays disabled by default, so most
  // deployments provision the name here and never set a value.
  // MAIL_INBOUND_SECRET is specs/email-inbound.md §8: the reply-token HMAC
  // key — consumed ONLY when MAIL_INBOUND_ENABLED=true; rotating it
  // invalidates every outstanding token at the next decode (the kill
  // switch, the runbook's inbound posture).
  "secrets": {
    "required": ["GIT_TOKEN", "MIRROR_ALLOWED_HOST_LIST", "MIRROR_CREDENTIAL_KEY", "MAIL_PROVIDER_API_KEY", "MAIL_INBOUND_SECRET"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoCell", "Registry"]
    }
  ]
}
