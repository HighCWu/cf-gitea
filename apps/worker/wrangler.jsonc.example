{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-gitea",
  "main": "src/index.ts",
  // Newest date the pinned local runtime supports (AGENTS.md wants today's
  // date; re-verified 2026-10-29 — wrangler 4.153.0 pairs miniflare
  // 5.20261023.0-beta / workerd 1.20261023.1, which runs compatibility
  // dates only through 2026-10-23, so no newer date is runnable yet).
  // Bump to the current date together with `pnpm update wrangler` +
  // `pnpm install`, then run `wrangler types`.
  "compatibility_date": "2026-10-23",
  "limits": {
    "cpu_ms": 300000
  },
  // Module rules: the fileicon layer (src/ui/fileicon/, cdf683a) imports its
  // basic-theme SVGs and both material-icon JSON pools as `*.svg?raw` /
  // *.json?raw strings — vite serves ?raw natively (so dev/tests never
  // trip), but `wrangler deploy`'s esbuild IGNORES the query and applies its
  // built-in loaders (the .json loader returns a PARSED OBJECT —
  // JSON.parse(object) threw on every tree-view envelope request in
  // production, 2026-10-26); rule globs must carry the query suffix
  // themselves (REDEPLOY18's controlled tests: plain **/*.svg does NOT match
  // **/*.svg?raw). LESSON: any NEW `?raw` import in the deploy entry graph
  // needs a glob member here — the vite affordance is invisible to wrangler
  // until an edge first carries it (svg at 831709f, json at this rule).
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.svg?raw", "**/*.json?raw"]
    }
  ],
  // Webhook payload compare URLs (mirror sync + user push) — upstream's own
  // AppURL equivalent. OPTIONAL: unset it and payload URLs automatically use
  // this deployment's own origin (a fresh Deploy-button deployment on
  // *.workers.dev needs zero configuration). Set it when serving behind a
  // custom domain, or for mirror deployments whose payload URLs must name a
  // different public origin. Local dev overrides via .dev.vars if needed.
  // (The line stays as documentation of the shape — the generated Env types
  // the declared var, and the fallback chain in
  // services/webhooks-push.ts `appOrigin` serves unset deployments.)
  "vars": {
    "APP_URL": "https://cf-gitea.YOUR-SUBDOMAIN.workers.dev",
    // Self-registration gate (SPEC-0010 §6): "true" adds a /user/sign_up page;
    // anything else keeps the instance closed — the first admin comes from the
    // login page's one-shot "initialize this instance" form (zero-user instances).
    "ALLOW_SIGNUP": "false",
    // Federation gate (specs/federation.md Tier A): ONLY the exact string
    // "true" mounts the discovery pair (GET /.well-known/nodeinfo,
    // GET /.well-known/webfinger) and the registered-but-501 stubs
    // (GET /api/v1/nodeinfo, ANY /api/v1/activitypub/*); absent/anything
    // else answers upstream's disabled posture — web pair 404 "Not Found",
    // API arms 404 from the router (fail-closed, upstream's own default:
    // setting.Federation.Enabled=false, modules/setting/federation.go:23;
    // the gate wraps the web pair at web.go:409-414 and the API
    // registration at api.go:1007-1010). Upstream retracted the ActivityPub
    // data plane at this pin (PR #36789 — "wait until the whole design is
    // stable and usable"), so even enabled, the webfinger JRD advertises
    // actor IRIs that answer 501 "Not implemented" — discovery-only, by
    // upstream's own posture.
    "FEDERATION_ENABLED": "false",
    // SPEC-0003 §2.4 row 6 (census B-34) — the require-sign-in-view instance
    // flag ([service] REQUIRE_SIGNIN_VIEW → Service.RequireSignInViewStrict,
    // modules/setting/service.go:43,170). Strict polarity, the DEMO_MODE
    // class: ONLY the exact string "true" arms it; absent/anything else
    // stays anonymous-readable (upstream's own default: the app.ini setting
    // is false). Armed, it refuses EVERY anonymous read: git-HTTP pulls 401
    // even on public repos and unit-grants (routers/web/repo/githttp.go:132,
    // test git_smart_http_test.go:186-188), API calls 403 {"message": "Only
    // signed in user is allowed to call APIs."} (api.go:905-910 mounted at
    // :961), and repo pages read as invisible to anonymous viewers (upstream
    // redirects to login at web.go:354; ours answers the 404-shell posture —
    // the recorded shape delta). Signed-in callers are never consulted.
    "REQUIRE_SIGNIN_VIEW": "false",
    // Census B-87 (PW16, SPEC-0002 §6.5 Phase C) — the password system's six
    // config knobs, upstream's [service]/[security] keys over wrangler vars.
    // Defaults here ARE upstream's defaults (ADR-0008: behavioral equivalence
    // at the default config).
    // ENABLE_PASSWORD_SIGNIN_FORM ([service] ENABLE_PASSWORD_SIGNIN_FORM →
    // Service.EnablePasswordSignInForm, modules/setting/service.go:180,
    // MustBool(true)) — the web login form's arm. "false" (or "0"/"f", the
    // go-ini bool parse) hides the WHOLE sign-in form (signin_inner.tmpl:
    // 13-49 wraps the <form>: user_name, password, remember, submit and the
    // forgot-password link) while external-auth buttons still render without
    // the "or" divider (:51); the POST /login arm answers upstream's
    // 403 (auth.go:293-295).
    "ENABLE_PASSWORD_SIGNIN_FORM": "true",
    // ENABLE_BASIC_AUTHENTICATION ([service] ENABLE_BASIC_AUTHENTICATION →
    // Service.EnableBasicAuth, service.go:179, MustBool(true)) — the git/API
    // Basic PASSWORD arm. "false" makes the Basic password method NOT
    // APPLICABLE (services/auth/basic.go:139-141): the request proceeds
    // ANONYMOUS (each endpoint's own auth requirement answers) — never the
    // generic 401; Basic-carried TOKENS keep working (the token arm runs
    // before the gate).
    "ENABLE_BASIC_AUTHENTICATION": "true",
    // PASSWORD_HASH_ALGO ([security] PASSWORD_HASH_ALGO →
    // setting.PasswordHashAlgo, security.go:175, MustString("")) — the
    // algorithm NEW passwords hash with (SetPassword) and the rehash target.
    // Names dealias to full specs (hash/setting.go:22-34): argon2, bcrypt,
    // scrypt, pbkdf2 (→ pbkdf2$50000$50), pbkdf2_v1, pbkdf2_v2, pbkdf2_hi;
    // "" = upstream's pbkdf2 default. A spec the runtime cannot execute
    // (scrypt, above-cap pbkdf2 params — workerd#1346) answers the recorded
    // controlled-refusal posture instead of upstream's boot-time log.Fatal.
    "PASSWORD_HASH_ALGO": "",
    // MIN_PASSWORD_LENGTH ([security] MIN_PASSWORD_LENGTH, security.go:167,
    // MustInt(8)) — the shared UpdateAuth ladder's floor (update.go:257);
    // non-numeric falls back to 8 (MustInt semantics).
    "MIN_PASSWORD_LENGTH": "8",
    // PASSWORD_COMPLEXITY ([security] PASSWORD_COMPLEXITY, security.go:
    // 209-218, Strings(",")) — comma-separated classes lower,upper,digit,spec.
    // UNSET/empty/"off" = NO complexity checking (upstream's default —
    // app.example.ini:503); a set with at least one valid class requires
    // those classes only; a set with NO valid class falls back to ALL four
    // (password.go:77-96's own fallback).
    "PASSWORD_COMPLEXITY": "",
    // PASSWORD_CHECK_PWN ([security] PASSWORD_CHECK_PWN, security.go:179,
    // MustBool(false) — pwn.go:37-39) — "true" checks new passwords against
    // the Have-I-Been-Pwned range API at every password-set arm (an outbound
    // fetch to api.pwnedpasswords.com; failures answer upstream's
    // password_pwned_err posture, never a silent pass).
    "PASSWORD_CHECK_PWN": "false",
    // SPEC-0014 §2 — the demo-operations gate. ONLY the exact string "true"
    // arms the demo sweep (hourly cron producer → {kind:"demo-sweep"} → the
    // existing delete cascade); absent/anything else stays OFF (fail-closed,
    // §6.8). Default OFF so a self-hosted deployment NEVER schedules cleanup
    // and NEVER deletes user data — the README's self-host guarantee (the §2
    // hard invariant). The demo instance is the ONLY deployment that sets it
    // to "true"; arming is a var edit + redeploy, never a runtime toggle.
    "DEMO_MODE": "false",
    // Audit-event retention window in days (SPEC-0015 M4 §4.3). Any value
    // other than a positive integer DISARMS the retention producer entirely
    // (fail-closed: no reads, no sends); the consumer defaults to 90.
    "AUDIT_RETENTION_DAYS": "90",
    // Actions retention windows in days (SPEC-0012 §4.4/§4.5) — the strict-
    // polarity trio. Upstream defaults 90/365/400 (modules/setting/actions.go:
    // 15-21); each value must be a positive integer or that arm stays OFF
    // (fail-closed: unset/garbage/zero/negative = no reads, no sends — unlike
    // upstream, whose cleanup cron is always-on with the defaults, a default
    // cf-gitea deployment NEVER deletes actions data). Arming any one var
    // enables the hourly probe + sweep for the armed arms only; the artifact
    // var additionally documents the upload-time expiry ceiling (that wiring
    // is a tracked follow-up). Set all three to 90/365/400 for upstream
    // behavior.
    "ACTIONS_ARTIFACT_RETENTION_DAYS": "90",
    "ACTIONS_LOG_RETENTION_DAYS": "365",
    "ACTIONS_RUN_RETENTION_DAYS": "400",
    // Packages registry (SPEC-0016): all strict-polarity — omitted falls back
    // to the code defaults (512 MiB generic cap, unlimited counts, enabled,
    // 24h cleanup window).
    "PACKAGES_LIMIT_SIZE_GENERIC": "536870912",
    "PACKAGES_LIMIT_TOTAL_OWNER_COUNT": "-1",
    "PACKAGES_LIMIT_TOTAL_OWNER_SIZE": "-1",
    "PACKAGES_ENABLED": "true",
    "PACKAGE_CLEANUP_OLDER_THAN": "24",
    // OAuth2 provider (specs/oauth2-provider.md §2.11, W4): strict polarity —
    // ONLY the exact string "false" disables; default "true" is upstream's
    // (setting.OAuth2.Enabled, modules/setting/oauth2.go:104). False ⇒ 403
    // on the whole /login/oauth group (web.go:373-378/631's oauth2Enabled),
    // 404 on /.well-known/openid-configuration (oauth2_wellknown.go:17-20),
    // and the git-HTTP 401 realm reverting to `Basic realm="Gitea (Basic
    // Auth)"` (githttp.go:146-159 — enabled answers `realm="Gitea"` so GCM
    // drives its built-in OAuth2 application, git-credential-manager#1442).
    "OAUTH2_ENABLED": "true",
    // The id_token/JWKS signing algorithm (specs/oauth2-provider.md §2.10):
    // one of HS256/384/512, RS256/384/512, ES256/384/512 (upstream's set,
    // modules/setting/oauth2.go:108; EdDSA is rejected-until-proven on
    // workerd — SPEC divergence (c)). The key lives in the `system_keystore`
    // `oauth2_signing_key` row (get-or-create on first use); HS* reuses the
    // shared general-token-signing-secret row (upstream's JWT_SECRET role).
    // RS256 stays the default and the recommended arm.
    "OAUTH2_SIGNING_ALGORITHM": "RS256",
    // The OIDC `iss` claim + discovery `issuer` override ([oauth2]
    // JWT_CLAIM_ISSUER, access_token.go:142-145). Empty/unset derives the
    // issuer from APP_URL minus the trailing slash — the
    // openid-connect-discovery §4 rule (the issuer MUST equal the URL
    // /.well-known/openid-configuration was fetched from). Only moves the
    // `issuer` member; the endpoint URLs always follow APP_URL.
    "OAUTH2_JWT_CLAIM_ISSUER": "",
    // The refresh-token rotation posture ([oauth2] INVALIDATE_REFRESH_TOKENS,
    // specs/oauth2-provider.md §4.16): strict-polarity — ONLY the exact string
    // "true" enables (the DEMO_MODE class); "true" rotates the grant's
    // outstanding refresh tokens on exchange (the CAS arm,
    // services/oauth2/token.ts:399-410). Default "false" is upstream's
    // (InvalidateRefreshTokens, modules/setting/oauth2.go:107) — refresh
    // tokens stay reusable until expiry.
    "OAUTH2_INVALIDATE_REFRESH_TOKENS": "false",
    // Outbound email (specs/email-outbound.md §6): strict-polarity, OFF by
    // default — a self-hosted deployment NEVER sends mail until armed, the
    // same fail-closed class as DEMO_MODE. Arming = MAIL_ENABLED "true" +
    // MAIL_FROM + a provider: "dummy" (the default — upstream's dummy
    // protocol, services/mailer/sender/dummy.go: render+log+succeed),
    // "resend" (the HTTP relay arm — also
    // `wrangler secret put MAIL_PROVIDER_API_KEY`), or "smtp" (census B-66:
    // the raw-socket port of upstream's default sender,
    // services/mailer/sender/smtp.go:27-60, over workerd's connect() TCP —
    // configured by the MAIL_SMTP_* block below; also
    // `wrangler secret put MAIL_SMTP_PASSWORD` when USER is set). The first
    // wired trigger is POST /admin/users with send_notify=true (upstream
    // routers/api/v1/admin/user.go:153-156); MAIL_SUBJECT_PREFIX /
    // MAIL_API_BASE are optional.
    "MAIL_ENABLED": "false",
    "MAIL_PROVIDER": "dummy",
    "MAIL_FROM": "",
    "MAIL_SUBJECT_PREFIX": "",
    "MAIL_API_BASE": "",
    // The SMTP transport arm's config (census B-66 — upstream's [mailer]
    // SMTP keys, modules/setting/mailer.go:36-43 + the :123-151 inference):
    // MAIL_SMTP_PROTOCOL "smtp" | "smtps" | "smtp+starttls" (empty infers
    // from MAIL_SMTP_PORT; both unset = upstream's smtps-on-465 fall-through;
    // sendmail and smtp+unix stay platform-impossible), MAIL_SMTP_ADDR the
    // host (required to arm the provider), MAIL_SMTP_PORT (empty infers
    // 25/465/587 from the protocol), MAIL_SMTP_USER (empty ⇒ the session
    // stays unauthenticated, upstream len(User)==0), MAIL_SMTP_ENABLE_HELO
    // (default on; only the literal "false" disables — MustBool(true)),
    // MAIL_SMTP_HELO_HOSTNAME (upstream defaults to os.Hostname(); workerd
    // has none — the recorded adaptation defaults to "localhost"),
    // MAIL_SMTP_ENVELOPE_FROM (upstream ENVELOPE_FROM — non-empty overrides
    // the envelope sender; "none" keeps the header From). Upstream's
    // FORCE_TRUST_SERVER_CERT has NO honest analogue (workerd always
    // verifies TLS; a self-signed relay cannot be trusted), and
    // USE_CLIENT_CERT/CLIENT_CERT_FILE/CLIENT_KEY_FILE have none either
    // (startTls takes no client certificate). TLS arms expect REAL-CA
    // certificates (smtps on 465 or smtp+starttls on 587).
    "MAIL_SMTP_PROTOCOL": "",
    "MAIL_SMTP_ADDR": "",
    "MAIL_SMTP_PORT": "",
    "MAIL_SMTP_USER": "",
    "MAIL_SMTP_ENABLE_HELO": "",
    "MAIL_SMTP_HELO_HOSTNAME": "",
    "MAIL_SMTP_ENVELOPE_FROM": "",
    // The notify-mail register gate (specs/email-outbound.md §6, the A2
    // fold): upstream's [service] ENABLE_NOTIFY_MAIL — the mail NOTIFIER
    // registers only when it sits ON TOP of a live mail service
    // (services/mailer/mailer.go:33-35 over loadNotifyMailFrom,
    // modules/setting/mailer.go:227-235). ONLY the exact string "true"
    // arms the participant fan-out (every issue/PR mail arm);
    // register-notify keeps riding MAIL_ENABLED alone. Unset/anything
    // else = participant mail OFF (fail-closed).
    "ENABLE_NOTIFY_MAIL": "",
    // Inbound email (specs/email-inbound.md §8): strict-polarity, OFF by
    // default — Cloudflare Email Routing delivers to the Worker's `email()`
    // handler (NO binding; the handler export is the whole story). Arming =
    // MAIL_INBOUND_ENABLED "true" + MAIL_INBOUND_REPLY_ADDRESS carrying
    // %{token} exactly once in the user part (upstream REPLY_TO_ADDRESS,
    // modules/setting/incoming_email.go:15,47-63) + `wrangler secret put
    // MAIL_INBOUND_SECRET` + an Email Routing rule on the zone delivering
    // to this Worker. Until the outbound notify fold (email-inbound §9
    // HANDOFF) no mail carries a token, so an armed inbound drops
    // everything at the no-token gate — fail-closed end to end.
    "MAIL_INBOUND_ENABLED": "false",
    "MAIL_INBOUND_REPLY_ADDRESS": "",
    // Git push size cap in MiB (the engine's receive quota — MAX_PUSH_MB,
    // packages/git-engine src/env.ts; consumed in src/mod.ts receivePack).
    // Unset/garbage falls back to the engine's own 512 MiB default
    // (DEFAULT_MAX_PUSH_MB, src/mod.ts), so the value here only DOCUMENTS
    // the shipped posture — tighten it to bound per-push memory. The cap
    // applies to the compressed request body too: a gzipped push body
    // (Content-Length-declared or counted off the stream) over the cap is
    // rejected 413 BEFORE the bytes buffer or the inflate runs.
    // RAISING it (e.g. 1024/2048) is the lever for server-side transfers a
    // client cannot split — a pull mirror's initial population fetches the
    // source's full pack in ONE internal receive (the git-HTTP request body
    // limit of a fronting proxy does not apply to that loopback call). Keep
    // the pairing in mind: the receive must also finish inside the receive
    // lease TTL (GIT_TIMEOUT_RECEIVE below), and its delta resolution spends
    // up to RANGE_BUDGET R2 range reads — raise them together when admitting
    // larger initial populations.
    // The auto-watch push flip (specs/email-outbound.md §15, the ledger's
    // M7): upstream's [service] AUTO_WATCH_ON_CHANGES
    // (modules/setting/service.go:216, default false) — a branch push by a
    // user with NO watch row lands the Auto watch (models/repo/watch.go:
    // 310-323, fired from services/repository/push.go:204-206). ONLY the
    // exact string "true" arms it; unset/anything else = off
    // (fail-closed). Consumed by services/webhooks-push.ts' watchIfAuto
    // fold (services/repo-watchers.ts).
    "AUTO_WATCH_ON_CHANGES": "",
    "MAX_PUSH_MB": "2048",
    // R2 range GETs one receive's delta resolution may spend (the engine's
    // receive quota — RANGE_BUDGET, packages/git-engine src/env.ts; default
    // 256, receive/delta.ts). Unset/garbage keeps the engine default, so the
    // value here only DOCUMENTS the shipped posture. Raise it (e.g. 1024) to
    // admit windowed pushes of large repositories, whose delta chains re-read
    // more staging bytes than the default budgets; every unit is one R2
    // subrequest against the platform's per-request subrequest cap (~1000,
    // shared with the receive's staging/idx/copy/RPC budget), so raise it
    // only as far as the window sizes you must admit require.
    "RANGE_BUDGET": "256",
    // Receive lease TTL in SECONDS — how long one push may hold a repo's
    // exclusive push slot after its holder stopped making progress (the
    // engine's GIT_TIMEOUT_RECEIVE, packages/git-engine src/env.ts; named for
    // upstream's [git.timeout] app.ini section, whose keys are seconds:
    // MIGRATE 600 / MIRROR 300 / GC 60 — upstream needs no receive key there
    // because its receive-pack is a child process that DIES on client
    // disconnect, releasing git's locks with it). A disconnected push here
    // releases the lease immediately (the engine's abort fast-fail, the
    // same cancel event); this TTL bounds only the SILENT drop — a client
    // that delivers neither bytes, EOF, nor a disconnect signal — which is
    // the L325 incident shape: each stalled holder 503'd every other push
    // until expiry. Default 900 (= the engine's historical 15-minute
    // backstop); floor 60, ceiling 86400; unset/garbage keeps the default.
    // Lower it to tighten the worst-case 503 window; raise it together with
    // MAX_PUSH_MB for long loopback transfers, and with the mirror
    // SYNCING_SWEEP_AFTER_SEC budget (services/mirror/sync.ts) if raised
    // past 900. A value above the queue/cron wall clocks does not extend
    // those consumers.
    "GIT_TIMEOUT_RECEIVE": "900",
    // SPEC-0024 M4.0: shift warm full-clone upload-pack streaming out of the
    // RepoCell DO into the Worker using single sequential R2 streams per pack
    // and zero-copy single-pack passthrough, with 20s official 0005\x01
    // keepalives (GIT_UPLOAD_KEEPALIVE_MS).
    "UPLOAD_PACK_WORKER_STREAM": "true",
    "GIT_UPLOAD_KEEPALIVE_MS": "20000",
    // SPEC-0024 M4.4b: Worker cold full-clone activation threshold (bytes; or >= 8 active packs).
    "WORKER_COLD_CLONE_MIN_BYTES": "8388608",
    // SPEC-0024 M4.1: shift pack compaction off the 32 MiB DO-heap merge onto
    // REPO_TASKS Queue streaming compaction with OFS_DELTA + .pref sidecars.
    "COMPACTION_QUEUE_ENABLED": "true",
    // SPEC-0024 M4.2: stream push packs directly to final R2 keys (zero copyObject, 64 MiB parts).
    "RECEIVE_DIRECT_PACK_WRITE": "true",
    // SPEC-0024 M4.3: strict-polarity flag ("true" enables Protocol v2 bundle-uri,
    // compaction bundle materialization >= BUNDLE_MIN_BYTES, and signed Range serving;
    // requires wrangler secret BUNDLE_SIGNING_SECRET).
    "BUNDLE_URI_ENABLED": "false",
    "BUNDLE_MIN_BYTES": "67108864",
    // LFS store mode (SPEC-0006 §6 as-built, the L14 config wave) — strict
    // polarity: ONLY the exact string "true" constructs the presign store
    // (PresignLfsStore) over the relay store; absent/anything else = relay
    // (fail-closed: a deployment never presigns by accident). Upstream's
    // posture is the storage ServeDirect gate (modules/setting/storage.go:
    // 49,96-98; services/lfs/server.go:496-503 falls back to the relayed
    // link). Arming ALSO requires the S3 credential triple — an incomplete
    // triple keeps relay (the §2.3 capability probe, never a 500): the two
    // SECRETS via `wrangler secret put R2_ACCESS_KEY_ID` /
    // `R2_SECRET_ACCESS_KEY`, plus R2_ACCOUNT_ID here. Presigned paths name
    // the shipped bucket (DEFAULT_R2_LFS_BUCKET_NAME, "cf-gitea-packs" —
    // setup-deploy.mjs provisions it; the R2 binding never exposes its name
    // at runtime).
    "LFS_STORE_PRESIGN": "false",
    "R2_ACCOUNT_ID": ""
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },

  // Single source of truth for bindings (AGENTS.md). This EXAMPLE file is the
  // template: `pnpm setup:deploy` copies it to wrangler.jsonc (gitignored)
  // and fills the real database_id; the Deploy-to-Cloudflare button
  // provisions resources and fills ids automatically. After any change here,
  // run `wrangler types` to regenerate worker-configuration.d.ts.

  // D1: relational metadata (ADR-0001 D3). The database_id placeholder is
  // filled by `pnpm setup:deploy` (or the deploy button); local dev and
  // tests do not use it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-gitea",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],

  // R2: blob storage (packs, later LFS/attachments) — SPEC-0001 §3.
  "r2_buckets": [
    {
      "binding": "REPO_PACKS",
      "bucket_name": "cf-gitea-packs"
    }
  ],

  // Static assets (SPEC-0008 §2.3.2, exact): the built Gitea frontend tree
  // (`pnpm build:assets` → ./public/assets, gitignored) plus the committed
  // public/_headers. Assets-first/worker-on-miss routing: GET/HEAD matching a
  // file in public/ is edge-served; a miss invokes the Worker. The four
  // git-protocol routes, /api/* and the LFS family are pinned to the Worker
  // first so they can never be shadowed by the asset tree (see the spec for
  // the enumeration rationale; two leading wildcards span /:owner/:repo(.git)?).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/v2/*",
      "/*/*/info/refs",
      "/*/*/git-upload-pack",
      "/*/*/git-receive-pack",
      "/*/*/HEAD",
      "/*/*/info/lfs/*",
      "/*/*/bundle/*"
    ]
  },

  // Durable Objects: the vendored engine's classes (packages/git-engine).
  // RepoCell = per-repo git storage (SPEC-0001 §2); Registry = repo index.
  // SQLite-backed classes only.
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO",
        "class_name": "RepoCell"
      },
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      }
    ]
  },

  // Cron triggers (SPEC-0009 §2.6): the pull-mirror sync producer fires the
  // 10-minute `update_mirrors` cadence (upstream tasks_basic.go:35). Sub-hour
  // crons get a 30 s CPU budget (AGENTS.md Workers rules), so the scheduled
  // handler only SELECTs due repo_mirrors rows and enqueues — the mirror-sync
  // work happens in the queue consumer.
  //
  // The hourly entry (SPEC-0014 §3.1) is the demo sweep's producer tick. The
  // scheduled dispatcher (services/demo-sweep.ts handleScheduledCron) routes
  // it ONLY to enqueueDueDemoSweeps, which checks DEMO_MODE before its first
  // D1 read — with the gate off (the default above) the invocation is a
  // silent no-op: zero D1 reads, zero queue sends. At :00 both entries fire
  // as separate invocations; the mirror producers keep their unconditional
  // posture on the */10 entries (their CAS guard absorbs any overlap).
  // OQ-2 (ratified): the entry ships in THIS example config even though a
  // gate-off deployment pays one no-op hourly invocation — config
  // monogeneity (this file is the single source of truth) beats a
  // hand-maintained demo delta whose worst failure is a silently-armed-but-
  // never-firing sweep.
  "triggers": {
    "crons": ["*/10 * * * *", "0 * * * *"]
  },

  // Queues: REPO_TASKS drives the repo delete purge (SPEC-0003 §2.5.5 steps
  // 2-3: D1 tx → DO tombstone → queue → R2 prefix purge). Batch 1 + a single
  // in-flight delivery keep each purge inside its own subrequest budget; the
  // consumer's steps are idempotent, so redelivery is safe. The import
  // indexing consumer (§2.6) and the pull-mirror sync consumer (SPEC-0009
  // §2.6, {kind: "mirror-sync"} messages from MIRROR_SYNC_QUEUE) join the
  // same queue + serialized consumer via the handleRepoTasks dispatch.
  "queues": {
    "producers": [
      { "binding": "WEBHOOK_DELIVERY", "queue": "webhook-delivery" },
      { "binding": "REPO_TASKS", "queue": "repo-tasks" },
      { "binding": "MIRROR_SYNC_QUEUE", "queue": "repo-tasks" }
    ],
    "consumers": [
      { "queue": "webhook-delivery", "max_retries": 3, "dead_letter_queue": "webhook-delivery-dlq" },
      { "queue": "webhook-delivery-dlq", "max_retries": 1, "max_batch_size": 10 },
      { "queue": "repo-tasks-dlq", "max_retries": 1, "max_batch_size": 10 },
      {
        "queue": "repo-tasks",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "repo-tasks-dlq"
      }
    ]
  },

  // Secrets (names only — values are NEVER in this file; AGENTS.md Workers
  // rules). `wrangler types` includes these in Env even without .dev.vars, so
  // CI typechecks stay honest; local dev supplies values via .dev.vars (copy
  // .dev.vars.example). Production: `wrangler secret put GIT_TOKEN`.
  // GIT_TOKEN gates git push/admin on the engine (SPEC-0001 M1); SPEC-0002
  // replaces the static token with real auth. The two MIRROR_* keys are
  // SPEC-0009 §4.1/§4.2 runtime config (SSRF allow-list + credential AES
  // key) — until they are declared here, wrangler silently ignores them in
  // .dev.vars (only declared names load; probed on wrangler 4.152).
  // MAIL_PROVIDER_API_KEY is specs/email-outbound.md §6: consumed ONLY when
  // MAIL_PROVIDER=resend; mail stays disabled by default, so most
  // deployments provision the name here and never set a value.
  // MAIL_SMTP_PASSWORD is specs/email-outbound.md §6 (census B-66):
  // consumed ONLY when MAIL_PROVIDER=smtp with MAIL_SMTP_USER set.
  // MAIL_INBOUND_SECRET is specs/email-inbound.md §8: the reply-token HMAC
  // key — consumed ONLY when MAIL_INBOUND_ENABLED=true; rotating it
  // invalidates every outstanding token at the next decode (the kill
  // switch, the runbook's inbound posture).
  "secrets": {
    "required": ["GIT_TOKEN", "MIRROR_ALLOWED_HOST_LIST", "MIRROR_CREDENTIAL_KEY", "MAIL_PROVIDER_API_KEY", "MAIL_SMTP_PASSWORD", "MAIL_INBOUND_SECRET", "BUNDLE_SIGNING_SECRET"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoCell", "Registry"]
    }
  ]
}
