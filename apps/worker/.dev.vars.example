GIT_TOKEN=devtoken
MIRROR_ALLOWED_HOST_LIST=
MIRROR_CREDENTIAL_KEY=z/+oz+c290fTJO5IyUZeMeCR/af0bNxWCfy6L9CH9ww=
DEMO_MODE=false
ALLOW_SIGNUP=false
# Federation (specs/federation.md Tier A) — OFF by default. Flip to "true"
# to exercise /.well-known/nodeinfo, /.well-known/webfinger and the 501
# stubs (/api/v1/nodeinfo, /api/v1/activitypub/*) locally. Note: vars must
# ALSO exist in your (gitignored) wrangler.jsonc copy for local dev to
# inject them — the vitest suite passes its own env slices, so it runs
# without these.
FEDERATION_ENABLED=false
# Outbound email (specs/email-outbound.md §6) — OFF by default; flip
# MAIL_ENABLED to "true" (+ MAIL_FROM, and MAIL_PROVIDER=resend with a real
# key) to exercise the relay locally.
MAIL_ENABLED=false
MAIL_PROVIDER=dummy
MAIL_FROM=
MAIL_SUBJECT_PREFIX=
MAIL_API_BASE=
MAIL_PROVIDER_API_KEY=
# The SMTP transport arm (census B-66) — flip MAIL_PROVIDER to "smtp" (+ the
# vars below) to exercise the raw-socket sender against a local listener,
# e.g. python3 -m smtpd style stubs. TLS arms expect REAL-CA certificates
# (workerd rejects self-signed on either side posture); the MAIL_SMTP_*
# semantics are documented in wrangler.jsonc.example's vars block.
MAIL_SMTP_PROTOCOL=
MAIL_SMTP_ADDR=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENABLE_HELO=
MAIL_SMTP_HELO_HOSTNAME=
MAIL_SMTP_ENVELOPE_FROM=
# Inbound email (specs/email-inbound.md §8) — OFF by default. Local
# exercise: set MAIL_INBOUND_ENABLED=true, a reply address carrying
# %{token} in the user part (the routed zone's domain), and any dev
# secret. Note: vars must ALSO exist in your (gitignored) wrangler.jsonc
# copy for local dev to inject them — the vitest suite passes its own env
# slices, so it runs without these.
MAIL_INBOUND_ENABLED=false
MAIL_INBOUND_REPLY_ADDRESS=
MAIL_INBOUND_SECRET=dev-inbound-secret-change-me
# OAuth2 provider (specs/oauth2-provider.md §2.10-§2.11, W4) — enabled by
# default (upstream's setting.OAuth2.Enabled default, modules/setting/
# oauth2.go:104); only the exact string "false" disables. OAUTH2_SIGNING_
# ALGORITHM picks the id_token/JWKS key (RS256 default; HS*/ES* per the
# SPEC's alg table) and OAUTH2_JWT_CLAIM_ISSUER overrides the OIDC `iss` +
# discovery issuer (empty = APP_URL sans trailing slash). Note: vars must
# ALSO exist in your (gitignored) wrangler.jsonc copy for local dev to
# inject them — the vitest suite passes its own env slices, so it runs
# without these.
OAUTH2_ENABLED=true
OAUTH2_SIGNING_ALGORITHM=RS256
OAUTH2_JWT_CLAIM_ISSUER=
OAUTH2_INVALIDATE_REFRESH_TOKENS=false
# Census B-87 (PW16, SPEC-0002 §6.5 Phase C) — the password system's six
# config knobs (upstream defaults; semantics documented in
# wrangler.jsonc.example's vars block). Local flips: set
# PASSWORD_COMPLEXITY=lower,upper,digit,spec to re-arm the all-classes
# ladder the pre-B-87 hardwire shipped, or ENABLE_BASIC_AUTHENTICATION /
# ENABLE_PASSWORD_SIGNIN_FORM to "false" to exercise the refusal shapes.
ENABLE_PASSWORD_SIGNIN_FORM=true
ENABLE_BASIC_AUTHENTICATION=true
PASSWORD_HASH_ALGO=
MIN_PASSWORD_LENGTH=8
PASSWORD_COMPLEXITY=
PASSWORD_CHECK_PWN=false
