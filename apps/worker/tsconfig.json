{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Ambient module types for `cloudflare:test` (@cloudflare/vitest-plugin).
    "types": ["@cloudflare/vitest-plugin/types"],
    // SPEC-0008 §2.2/§2.4: Hono JSX server components under src/ui.
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": [
    // Generated by `wrangler types` — global Env + Workers runtime types.
    "worker-configuration.d.ts",
    "src",
    "*.ts"
  ]
}
